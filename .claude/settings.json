{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-to-origin.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing to origin…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-note-reminder.sh\"",
            "statusMessage": "Checking release notes…"
          }
        ]
      }
    ]
  }
}
